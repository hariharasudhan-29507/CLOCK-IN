{
  "name": "coral",
  "version": "0.1.0",
  "private": true,
  "description": "Coral desktop app with chat, profiles, friends, and calls.",
  "type": "module",
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:desktop": "npm run dev -w @coral/desktop",
    "dev:gateway": "npm run dev -w @coral/gateway",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@sentry/electron": "^7.13.0",
    "@sentry/esbuild-plugin": "^5.3.0",
    "@sentry/vite-plugin": "^5.3.0"
  }
}
